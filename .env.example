# GEMINI_API_KEY: Fallback chat + TTS. Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DEEPSEEK_API_KEY: Required for DeepSeek Voice Assistant (R1/V3 streaming & function tools).
DEEPSEEK_API_KEY=
VITE_DEEPSEEK_API_KEY=

# CLAUDE_API_KEY / ANTHROPIC_API_KEY: Primary chat model
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=

# ELEVENLABS_API_KEY: Required for natural voice — elevenlabs.io
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# REPLICATE_API_TOKEN: Required for Kimi-Audio (Moonshot AI) Voice Layer (ASR + TTS).
REPLICATE_API_TOKEN=
REACT_APP_REPLICATE_API_TOKEN=
VITE_REPLICATE_API_TOKEN=
